<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="0dp"
    android:background="@color/white"
    android:gravity="center">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginVertical="10dp"
        app:cardCornerRadius="30dp"
        android:elevation="20dp"
        android:background="@drawable/login_register_edits"
        android:backgroundTint="#FFFAFA"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="center_horizontal"
            android:padding="10dp">

    <TextView
        android:id="@+id/tvAdd"
        android:layout_height="wrap_content"
        android:layout_width="match_parent"
        android:text="Add new study session"
        android:textSize="37sp"
        android:textColor="@color/light_blue"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="Title:"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@+id/tvAdd"/>

    <EditText
        android:id="@+id/etTitle"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginStart="120dp"
        android:layout_marginTop="30dp"
        android:background="@drawable/input_fields"
        android:elevation="4dp"
        app:layout_constraintStart_toEndOf="@+id/tvTitle"
        app:layout_constraintTop_toBottomOf="@+id/tvAdd"/>

    <TextView
        android:id="@+id/tvDate"
        android:layout_height="wrap_content"
        android:layout_width="100dp"
        android:text="Date:"
        android:textSize="20sp"
        android:textColor="@color/black"
        android:layout_marginTop="27dp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@+id/etTitle"
        app:layout_constraintStart_toStartOf="parent"
        />

    <EditText
        android:id="@+id/etDate"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginStart="120dp"
        android:layout_marginTop="17dp"
        android:background="@drawable/input_fields"
        android:elevation="4dp"
        app:layout_constraintStart_toEndOf="@+id/tvDate"
        app:layout_constraintTop_toBottomOf="@+id/etTitle"/>

    <TextView
        android:id="@+id/tvTime"
        android:layout_height="wrap_content"
        android:layout_width="100dp"
        android:text="Time:"
        android:textSize="20sp"
        android:textColor="@color/black"
        android:layout_marginTop="27dp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@+id/etDate"
        app:layout_constraintStart_toStartOf="parent"
        />

    <EditText
        android:id="@+id/etTime"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginStart="120dp"
        android:layout_marginTop="17dp"
        android:background="@drawable/input_fields"
        android:elevation="4dp"
        app:layout_constraintStart_toEndOf="@+id/tvTime"
        app:layout_constraintTop_toBottomOf="@+id/etDate"/>

    <TextView
        android:id="@+id/tvLocation"
        android:layout_height="wrap_content"
        android:layout_width="100dp"
        android:text="Location:"
        android:textSize="20sp"
        android:textColor="@color/black"
        android:layout_marginTop="27dp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@+id/etTime"
        app:layout_constraintStart_toStartOf="parent"
        />

    <EditText
        android:id="@+id/etLocation"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginStart="120dp"
        android:layout_marginTop="17dp"
        android:background="@drawable/input_fields"
        android:elevation="4dp"
        app:layout_constraintStart_toEndOf="@+id/tvLocation"
        app:layout_constraintTop_toBottomOf="@+id/etTime"/>

    <TextView
        android:id="@+id/tvAvailability"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:text="Availability:"
        android:textSize="20sp"
        android:textColor="@color/black"
        android:layout_marginTop="27dp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@+id/etLocation"
        app:layout_constraintStart_toStartOf="parent"
        />

    <EditText
        android:id="@+id/etAvailability"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginStart="120dp"
        android:layout_marginTop="17dp"
        android:background="@drawable/input_fields"
        android:elevation="4dp"
        app:layout_constraintStart_toEndOf="@+id/tvAvailability"
        app:layout_constraintTop_toBottomOf="@+id/etLocation"/>

    <TextView
        android:id="@+id/tvDescription"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:text="Description:"
        android:textSize="20sp"
        android:textColor="@color/black"
        android:layout_marginTop="27dp"
        app:layout_constraintTop_toBottomOf="@+id/etAvailability"
        app:layout_constraintStart_toStartOf="parent"
        />

    <EditText
        android:id="@+id/etDescription"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginStart="120dp"
        android:layout_marginTop="17dp"
        android:background="@drawable/input_fields"
        android:elevation="4dp"
        android:minLines="3"
        android:scrollbars="vertical"
        app:layout_constraintStart_toEndOf="@+id/tvDescription"
        app:layout_constraintTop_toBottomOf="@+id/etAvailability" />

    <Button
        android:id="@+id/add_study_session"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:text="Add Session"
        android:textSize="20dp"
        android:textAllCaps="false"
        android:backgroundTint="@color/light_blue"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etDescription"
        />

    </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>