<?xml version="1.0"
    encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textViewTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/brown_dark"
                android:textSize="18sp"
                android:fontFamily="serif"
                android:textStyle="bold"
                tools:text="Meeting Agenda" />

            <ImageButton
                android:id="@+id/buttonDelete"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Delete Note"
                android:src="@android:drawable/ic_menu_delete"
                app:tint="#94A3B8" />
        </LinearLayout>
        <TextView
            android:id="@+id/textViewContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxLines="3"
            android:ellipsize="end"
            android:textColor="#334155"
            android:textSize="14sp"
            tools:text="Discuss product roadmap, Q3 deliverables, and team expansion
strategies." />
        <LinearLayout
            android:id="@+id/layoutPdfBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#F1F5F9"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="PDF Icon"
                android:src="@android:drawable/ic_menu_save"
                app:tint="#2563EB" />
            <TextView
                android:id="@+id/textViewPdfName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="middle"
                android:maxLength="30"
                android:singleLine="true"
                android:textColor="#2563EB"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Attachment Document.pdf" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>